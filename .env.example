APP_PORT=8082

# =================================
# Database Configuration
# =================================
DB_HOST=db
DB_PORT=3306
DB_NAME=userdb
DB_USER=user
DB_PASS=change_me_db_password

MYSQL_ROOT_PASSWORD=change_me_root_password


# =================================
# Email Configuration
# =================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Go User Auth API <no-reply@example.com>"

ENABLE_EMAIL=
RESET_PASSWORD_URL=http://localhost:8085/reset-password


# =================================
# JWT Configuration
# Keys must be at least 32 characters; use long random values (e.g. 64 hex chars).
# =================================
JWT_SIGN_KEY=replace_with_a_secure_random_signing_key_at_least_32_chars
JWT_REFRESH_KEY=replace_with_a_secure_random_refresh_key_at_least_32_chars
JWT_RESET_KEY=replace_with_a_secure_random_reset_key_at_least_32_chars

# Access token lifetime (keep short; refresh tokens renew sessions).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h


# =================================
# HTTP / API surface
# =================================
# Comma-separated explicit origins allowed for cross-origin requests.
# Empty = same-origin only (secure default). Wildcard '*' is rejected.
CORS_ALLOWED_ORIGINS=

# Swagger UI is opt-in and should normally remain disabled in production.
# Set to true only for local development.
ENABLE_SWAGGER=false


# =================================
# Rate Limiting
# =================================
RATE_LIMIT_REGISTER=3-M
RATE_LIMIT_LOGIN=5-M
RATE_LIMIT_FORGOT_PASSWORD=2-M
RATE_LIMIT_REFRESH=10-M
RATE_LIMIT_RESET_PASSWORD=5-M


# =================================
# Grafana Configuration
# =================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password
