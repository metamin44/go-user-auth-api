APP_PORT=8082

# =================================
# Database Configuration
# =================================
DB_HOST=db
DB_PORT=3306
DB_NAME=userdb
DB_USER=user
DB_PASS=change_me_db_password

MYSQL_ROOT_PASSWORD=change_me_root_password


# =================================
# Email Configuration
# =================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Go User Auth API <no-reply@example.com>"

ENABLE_EMAIL=
ENABLE_LOGS=
RESET_PASSWORD_URL=http://localhost:8085/reset-password


# =================================
# JWT Configuration
# =================================
JWT_SIGN_KEY=replace_with_secure_signing_key
JWT_REFRESH_KEY=replace_with_secure_refresh_key
JWT_RESET_KEY=replace_with_secure_reset_key


# =================================
# Rate Limiting
# =================================
RATE_LIMIT_REGISTER=
RATE_LIMIT_LOGIN=
RATE_LIMIT_FORGOT_PASSWORD=
RATE_LIMIT_REFRESH=10-M
RATE_LIMIT_RESET_PASSWORD=5-M


# =================================
# Grafana Configuration
# =================================
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_grafana_password
